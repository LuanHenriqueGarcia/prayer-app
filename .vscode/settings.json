{
  // IntelliSense uses the flags of the Debug build (generated by "Compilar Debug").
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build-debug/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++17",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[bat]": { "files.eol": "\r\n" },
  "cmake.configureOnOpen": false,
  "files.exclude": { "build": true, "build-debug": true },
  "search.exclude": { "build": true, "build-debug": true }
}
